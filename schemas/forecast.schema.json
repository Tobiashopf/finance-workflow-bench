{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cash Forecast 001 submission",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "const": "cash_forecast_001"
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "weeks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "properties": {
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          },
          "start_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "receipts": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "supplier_payments": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "tax_payments": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "other_external_payments": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "payroll_payments": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "rent_payments": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "other_recurring_payments": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "opening_cash": {
            "type": "string",
            "pattern": "^-?[0-9]{1,16}\\.[0-9]{2}$"
          },
          "cash_before_financing": {
            "type": "string",
            "pattern": "^-?[0-9]{1,16}\\.[0-9]{2}$"
          },
          "closing_cash": {
            "type": "string",
            "pattern": "^-?[0-9]{1,16}\\.[0-9]{2}$"
          },
          "opening_principal": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "interest_paid": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "credit_draw": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "principal_repayment": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "closing_principal": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "credit_available": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "minimum_cash_shortfall": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "unfunded_cash_deficit": {
            "type": "string",
            "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"
          },
          "minimum_cash_breached": {
            "type": "boolean"
          },
          "unfunded_deficit": {
            "type": "boolean"
          }
        },
        "required": [
          "week",
          "start_date",
          "end_date",
          "receipts",
          "supplier_payments",
          "tax_payments",
          "other_external_payments",
          "payroll_payments",
          "rent_payments",
          "other_recurring_payments",
          "opening_cash",
          "cash_before_financing",
          "closing_cash",
          "opening_principal",
          "interest_paid",
          "credit_draw",
          "principal_repayment",
          "closing_principal",
          "credit_available",
          "minimum_cash_shortfall",
          "unfunded_cash_deficit",
          "minimum_cash_breached",
          "unfunded_deficit"
        ],
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "source_file": {
            "type": "string",
            "enum": [
              "receivables.csv",
              "payables.csv",
              "recurring_expenses.csv"
            ]
          },
          "record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "enum": [
              "outside_horizon",
              "internal_transfer",
              "zero_outstanding"
            ]
          }
        },
        "required": [
          "source_file",
          "record_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "duplicates_removed": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "source_file": {
            "type": "string",
            "enum": [
              "receivables.csv",
              "payables.csv",
              "recurring_expenses.csv"
            ]
          },
          "record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "discarded_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": [
          "source_file",
          "record_id",
          "discarded_count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "case_id",
    "currency",
    "weeks",
    "exclusions",
    "duplicates_removed"
  ],
  "additionalProperties": false
}
